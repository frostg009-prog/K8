# ---- CM5-DETECT rev0.3 (append to /boot/firmware/config.txt)
# cameras: CAM1 = MIPI0 (cam0), CAM2 = MIPI1 (cam1); IMX477 (HQ) / IMX296 (GS) / IMX708 (Camera 3)
camera_auto_detect=0
dtoverlay=imx477,cam0
dtoverlay=imx477,cam1
# CAM2 I2C on GPIO0/1 (as CM5 IO board with J6 fitted)
dtparam=i2c_vc=on
# UARTs: UART0 (GPIO14/15) -> Matek, UART2 (GPIO4/5) -> GPS/telemetry, UART3 (GPIO8/9) -> supervisor MCU
enable_uart=1
dtoverlay=uart0-pi5
dtoverlay=uart2-pi5
dtoverlay=uart3-pi5
# I2C1 (GPIO2/3): temperature sensor NST175 @0x48, external JST-GH I2C, thermal camera aux
dtparam=i2c_arm=on
dtoverlay=i2c-sensor,tmp102,addr=0x48
# servo outputs: hardware PWM on GPIO12,13,18,19
dtoverlay=pwm-2chan,pin=12,func=4,pin2=13,func2=4
dtoverlay=pwm-2chan,pin=18,func=2,pin2=19,func2=2
# USB-C #1 = USB device (gadget: network + serial over USB to the PC); USB-C #2 + thermal USB = host
dtoverlay=dwc2,dr_mode=peripheral
# power-fail line from supervisor -> clean shutdown (systemd) ; RUN LED on GPIO20
dtoverlay=gpio-shutdown,gpio_pin=23,active_low=1,gpio_pull=up,debounce=10
# PCIe FFC for Hailo (Gen2 official, Gen3 possible but not guaranteed)
dtparam=pciex1
dtparam=pciex1_gen=2
# BCM2712 internal watchdog as second level
dtparam=watchdog=on
# fan (mandatory, 40 mm 5 V on the lid) on J_FAN: pin1 +5V, pin2 PWM (CM5 Fan_PWM), pin3 GND, pin4 TACH
# PWM fan: speed follows the SoC temperature; 2-wire fan: runs at full speed whenever +5V_AUX is on
dtparam=cooling_fan=on
dtparam=fan_temp0=50000,fan_temp0_hyst=5000,fan_temp0_speed=90
dtparam=fan_temp1=60000,fan_temp1_hyst=5000,fan_temp1_speed=150
dtparam=fan_temp2=67500,fan_temp2_hyst=5000,fan_temp2_speed=200
dtparam=fan_temp3=75000,fan_temp3_hyst=5000,fan_temp3_speed=255
